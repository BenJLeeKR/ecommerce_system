# =============================================================================
# Codex–Jules Thin Orchestrator 로컬 비밀값 예시
# =============================================================================
#
# 사용 방법
# 1. 이 파일을 `.orchestrator/.env`로 복사합니다.
# 2. 아래 두 값은 `.orchestrator/.env`에만 입력합니다.
# 3. `.env`는 Git에 올리거나 PR·문서·Worklog·결과 패키지에 첨부하지 마세요.
# 4. `load_jules_runtime_config()`은 기본적으로 이 파일 경로를 읽습니다.
#
# ---- Jules REST API 런타임 설정 --------------------------------------------
# 실제 키, 토큰, source resource name, 원시 프롬프트, 원시 활동 및 실행 로그는
# 터미널 출력·오류 메시지·커밋 메시지·PR 본문에도 포함하지 않습니다.
# 호출자는 로더가 반환한 값을 실제 Jules API 호출 직전에만 사용해야 하며,
# 키와 source resource name을 표시하거나 저장하지 않습니다.
#
# 이 파일은 예시이므로 실제 값을 적지 않습니다. `.env`만 로컬에 보관하세요.
# API 키는 필요하면 Jules API 키 관리 화면에서 교체·폐기할 수 있습니다.
JULES_API_KEY=
#
# ---- Jules 런타임 경로 설정 --------------------------------------------
JULES_SOURCE_RESOURCE_NAME=
